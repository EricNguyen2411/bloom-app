rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these two specific, real Firebase accounts can read or write —
    // not "anyone who knows the code," not "anyone who opened the link."
    // Replace the two placeholder emails below with the exact email
    // addresses of the two accounts you create in Firebase Console ->
    // Authentication -> Users -> Add user. Anonymous sign-in is no longer
    // used at all, so there's nothing left for a stranger to sign in as.
    match /couples/{coupleId}/{document=**} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in [
          'REPLACE_WITH_PARTNER_1_EMAIL@example.com',
          'REPLACE_WITH_PARTNER_2_EMAIL@example.com'
        ];
    }
  }
}
