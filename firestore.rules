rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone signed in anonymously (i.e. anyone who has opened the app link)
    // can read/write — the real privacy comes from COUPLE_ID being a private,
    // made-up code that only the two of you know. Fine for a personal gift app,
    // not bank-grade security — don't put anything in here you'd hate to have exposed.
    match /couples/{coupleId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
